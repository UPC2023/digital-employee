# ============================================
# HR Agent 配置文件模板
# 复制此文件为 .env 并填入实际值
# ============================================

# LLM 提供方切换：deepseek（默认） | ark（火山方舟）
LLM_PROVIDER=deepseek

# DeepSeek API 配置（或替换为其他兼容接口的模型）
DEEPSEEK_API_KEY=your
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 火山方舟（Volcano Engine Ark）配置 —— 待成员B接管后启用
# 适用场景：DeepSeek 配额耗尽/并发受限时降级，或对比豆包等模型效果
# 启用方式：将上方 LLM_PROVIDER 改为 ark，并填写下方配置
# ARK 提供 OpenAI 兼容接口，endpoint 形如 https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your_volcano_ark_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=your_ark_endpoint_id

# HuggingFace 镜像（RAG embedding 模型下载，国内网络建议保留）
HF_ENDPOINT=https://hf-mirror.com

# 数据库配置
DATABASE_PATH=./data/hr_agent.db

# 应用配置
APP_NAME=HR数字员工
APP_ENV=development
